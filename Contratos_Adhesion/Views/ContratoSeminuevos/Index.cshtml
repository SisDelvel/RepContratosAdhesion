                    <i class="bi bi-cloud-upload-fill me-1"></i>Generar y subir PDF
                </button>
                <div id="spUploadResult" class="d-none mt-2"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let ventaIdActual       = null;

    const constantesSharePoint = { DRIVE_ID: '', ACCESS_TOKEN: '' };

    const set = (id, val) => {
        const el = document.getElementById(id);
        if (el && val != null && val !== '') el.value = val;
    };
    const setText = (id, val) => {
        const el = document.getElementById(id);
        if (el && val != null && val !== '') el.textContent = val;
    };
    const chkSet = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.checked = !!val;
    };


    /* ── Llenar campos ───────────────────────────────── */
    function llenarCampos(dto) {
        document.querySelectorAll('#contratoWrapper input[readonly]').forEach(el => { el.value = ''; });

        setText('denominacion',              dto.denominacion);
        setText('rfcDistribuidora',          dto.rfc);
        setText('domicilioDistribuidora',    dto.domicilio);
        setText('telefonoDistribuidora',     dto.telefono);
        setText('horarioDistribuidora',      dto.horarioAtencion);
        setText('localidadDistribuidora',    dto.localidad);
        setText('correoDistribuidoraHeader', dto.correoDistribuidora || 'atencionclientes@toyotaqueretaro.mx');

        set('folio',      dto.folio);
        set('fechaOrden', dto.fecha);

        set('nombreCliente',    dto.nombreCliente);
        set('rfcCliente',       dto.rfcCliente);
        set('calleCliente',     dto.calle);
        set('extCliente',       dto.numExt);
        set('intCliente',       dto.numInt);
        set('coloniaCliente',   dto.colonia);
        set('cpCliente',        dto.codigoPostal);
        set('municipioCliente', dto.delegacion);
        set('estadoCliente',    dto.estado);
        set('telefonoCliente',  dto.telefonos);
        set('emailCliente',     dto.correo);

        set('marca',        dto.marca);
        set('submarca',     dto.submarca);
        set('catalogo',     dto.catalogo);
        set('tipoVersion',  dto.tipoVersion);
        set('color',        dto.color);
        set('anioModelo',   dto.anioModelo);
        set('kmRecorridos', dto.kmRecorridos);
        set('placas',       dto.placas);
        set('niv',          dto.niv);
        set('capacidad',    dto.capacidad);
        set('fechaEntrega', dto.fechaEntrega);
        set('lugarEntrega', dto.lugarEntrega);

        set('precioVehiculo', dto.precioVehiculo);
        set('equipo',         dto.equipo);
        set('otrosCargos',    dto.otrosCargos);
        set('iva',            dto.iva);
        const spanMonto = document.getElementById('montoTotalSpan');
        if (spanMonto && dto.montoTotal) spanMonto.textContent = dto.montoTotal;

        set('condicion',   dto.condicion);
        set('pagoContado', dto.pagoContado);
        set('enganche',    dto.enganche || '$0.00');

        set('usadaNiv',      dto.usadaNiv);
        set('usadaMarca',    dto.usadaMarca);
        set('usadaSubmarca', dto.usadaSubmarca);
        set('usadaVersion',  dto.usadaVersion);
        set('usadaColor',    dto.usadaColor);
        set('usadaAnio',     dto.usadaAnio);
        set('usadaValor',    dto.usadaValor);

        set('firmaDistribuidorNombre', dto.denominacion);
        set('firmaClienteNombre',      dto.nombreCliente);

        // Exteriores
        chkSet('chkExtLimpiaparabrisas', dto.extLimpiaparabrisas);
        chkSet('chkExtLuces',            dto.extLuces);
        chkSet('chkExtAntena',           dto.extAntena);
        chkSet('chkExtEspejosLat',       dto.extEspejosLat);
        chkSet('chkExtCristales',        dto.extCristales);
        chkSet('chkExtTapones',          dto.extTapones);
        chkSet('chkExtMolduras',         dto.extMolduras);
        chkSet('chkExtTaponGas',         dto.extTaponGas);
        chkSet('chkExtClaxon',           dto.extClaxon);
        // Interiores
        chkSet('chkIntInstrumentos', dto.intInstrumentos);
        chkSet('chkIntCalefaccion',  dto.intCalefaccion);
        chkSet('chkIntAire',         dto.intAire);
        chkSet('chkIntRadio',        dto.intRadio);
        chkSet('chkIntBocinas',      dto.intBocinas);
        chkSet('chkIntEncendedor',   dto.intEncendedor);
        chkSet('chkIntEspejoRet',    dto.intEspejoRet);
        chkSet('chkIntCeniceros',    dto.intCeniceros);
        chkSet('chkIntCinturones',   dto.intCinturones);
        chkSet('chkIntTapetes',      dto.intTapetes);
        chkSet('chkIntManijas',      dto.intManijas);
        chkSet('chkIntEquipoAd',     dto.intEquipoAd);
        chkSet('chkIntAccesorios',   dto.intAccesorios);
        chkSet('chkIntOtros',        dto.intOtros);
        // Mecánicos
        chkSet('chkMecLlantas',    dto.mecLlantas);
        chkSet('chkMecRuedas',     dto.mecRuedas);
        chkSet('chkMecRines',      dto.mecRines);
        chkSet('chkMecEscape',     dto.mecEscape);
        chkSet('chkMecDireccion',  dto.mecDireccion);
        chkSet('chkMecSuspension', dto.mecSuspension);
        chkSet('chkMecFrenos',     dto.mecFrenos);
        chkSet('chkMecParabrisas', dto.mecParabrisas);
        chkSet('chkMecCarroceria', dto.mecCarroceria);
        // Garantía
        if (dto.sinGarantia) document.getElementById('sinGarantiaRadio').checked = true;
        else if (dto.conGarantia) document.getElementById('conGarantiaRadio').checked = true;
        // Docs art. 7
        chkSet('chkDoc7Factura',       dto.doc7Factura);
        chkSet('chkDoc7Tarjeta',       dto.doc7Tarjeta);
        chkSet('chkDoc7DocsOficiales', dto.doc7DocsOficiales);
        chkSet('chkDoc7Manual',        dto.doc7Manual);
        chkSet('chkDoc7Tenencias',     dto.doc7Tenencias);
        chkSet('chkDoc7Verificacion',  dto.doc7Verificacion);
        chkSet('chkDoc7Multas',        dto.doc7Multas);
        // Docs art. 10
        chkSet('chkDoc10Factura',       dto.doc10Factura);
        chkSet('chkDoc10DocsOficiales', dto.doc10DocsOficiales);
        chkSet('chkDoc10Constancia',    dto.doc10Constancia);
        chkSet('chkDoc10Tenencias',     dto.doc10Tenencias);
        chkSet('chkDoc10Verificacion',  dto.doc10Verificacion);
        chkSet('chkDoc10Multas',        dto.doc10Multas);
        chkSet('chkDoc10Manual',        dto.doc10Manual);

        // Firmas
        const cargarImg = (imgId, phId, base64) => {
            const img = document.getElementById(imgId);
            const ph  = document.getElementById(phId);
            if (img && base64) {
                img.src = base64;
                img.style.display = 'block';
                if (ph) ph.style.display = 'none';
            }
        };
        cargarImg('imgFirmaDistribuidor', 'firmaDistPlaceholder', dto.firmaDistribuidor);
        cargarImg('imgFirmaCliente',      'firmaCliPlaceholder',  dto.firmaCliente);

    }


    /* ── Búsqueda ────────────────────────────────────── */
    async function buscarVenta() {
        const ventaId = document.getElementById('inputVentaId').value.trim();
        if (!ventaId) return mostrarError('Ingresa un ID de orden.');

        const btn   = document.getElementById('btnBuscar');
        const errEl = document.getElementById('busquedaError');
        errEl.classList.add('d-none');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Cargando...';

        try {
            const res = await fetch(
                `/ContratoSeminuevos/ObtenerDatosContrato?ventaId=${encodeURIComponent(ventaId)}`,
                { headers: { 'X-Requested-With': 'XMLHttpRequest' } }
            );

            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.mensaje || `Error al obtener los datos (${res.status}).`);
            }

            const dto = await res.json();
            ventaIdActual = ventaId;
            document.getElementById('busquedaPanel').classList.add('d-none');
            document.getElementById('contratoWrapper').classList.remove('d-none');
            llenarCampos(dto);

        } catch (e) {
            mostrarError(e.message || 'Error inesperado.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search me-2"></i>Cargar Orden';
        }
    }

    /* ── Guardar ─────────────────────────────────────── */
    async function guardarContrato() {
        if (!ventaIdActual) return false;

        const getImgSrc = (id) => {
            const img = document.getElementById(id);
            return img && img.src && img.src !== window.location.href ? img.src : null;
        };
        const chk = (id) => document.getElementById(id)?.checked ?? false;

        const payload = {
            idVenta:             parseInt(ventaIdActual),
            fechaEntrega:        document.getElementById('fechaEntrega')?.value || null,
            correoDistribuidora: 'atencionclientes@toyotaqueretaro.mx',
            // Exteriores
            extLimpiaparabrisas: chk('chkExtLimpiaparabrisas'),
            extLuces:            chk('chkExtLuces'),
            extAntena:           chk('chkExtAntena'),
            extEspejosLat:       chk('chkExtEspejosLat'),
            extCristales:        chk('chkExtCristales'),
            extTapones:          chk('chkExtTapones'),
            extMolduras:         chk('chkExtMolduras'),
            extTaponGas:         chk('chkExtTaponGas'),
            extClaxon:           chk('chkExtClaxon'),
            // Interiores
            intInstrumentos: chk('chkIntInstrumentos'),
            intCalefaccion:  chk('chkIntCalefaccion'),
            intAire:         chk('chkIntAire'),
            intRadio:        chk('chkIntRadio'),
            intBocinas:      chk('chkIntBocinas'),
            intEncendedor:   chk('chkIntEncendedor'),
            intEspejoRet:    chk('chkIntEspejoRet'),
            intCeniceros:    chk('chkIntCeniceros'),
            intCinturones:   chk('chkIntCinturones'),
            intTapetes:      chk('chkIntTapetes'),
            intManijas:      chk('chkIntManijas'),
            intEquipoAd:     chk('chkIntEquipoAd'),
            intAccesorios:   chk('chkIntAccesorios'),
            intOtros:        chk('chkIntOtros'),
            // Mecánicos
            mecLlantas:    chk('chkMecLlantas'),
            mecRuedas:     chk('chkMecRuedas'),
            mecRines:      chk('chkMecRines'),
            mecEscape:     chk('chkMecEscape'),
            mecDireccion:  chk('chkMecDireccion'),
            mecSuspension: chk('chkMecSuspension'),
            mecFrenos:     chk('chkMecFrenos'),
            mecParabrisas: chk('chkMecParabrisas'),
            mecCarroceria: chk('chkMecCarroceria'),
            // Garantía
            sinGarantia: chk('sinGarantiaRadio'),
            conGarantia: chk('conGarantiaRadio'),
            // Docs art. 7
            doc7Factura:       chk('chkDoc7Factura'),
            doc7Tarjeta:       chk('chkDoc7Tarjeta'),
            doc7DocsOficiales: chk('chkDoc7DocsOficiales'),
            doc7Manual:        chk('chkDoc7Manual'),
            doc7Tenencias:     chk('chkDoc7Tenencias'),
            doc7Verificacion:  chk('chkDoc7Verificacion'),
            doc7Multas:        chk('chkDoc7Multas'),
            // Docs art. 10
            doc10Factura:       chk('chkDoc10Factura'),
            doc10DocsOficiales: chk('chkDoc10DocsOficiales'),
            doc10Constancia:    chk('chkDoc10Constancia'),
            doc10Tenencias:     chk('chkDoc10Tenencias'),
            doc10Verificacion:  chk('chkDoc10Verificacion'),
            doc10Multas:        chk('chkDoc10Multas'),
            doc10Manual:        chk('chkDoc10Manual'),
            // Firmas
            firmaDistribuidor: getImgSrc('imgFirmaDistribuidor'),
            firmaCliente:      getImgSrc('imgFirmaCliente'),
        };

        const btn = document.querySelector('button[onclick="guardarContrato()"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

        try {
            const res = await fetch('/ContratoSeminuevos/GuardarContrato', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) throw new Error(`Error al guardar (${res.status}).`);

            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardado';
            btn.classList.replace('btn-success', 'btn-outline-success');
            return true;

        } catch (e) {
            alert(e.message || 'Error inesperado al guardar.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-floppy-fill me-1"></i>Guardar';
            return false;
        }
    }

    /* ── PDF ─────────────────────────────────────────── */
    async function generarPDF() {
        if (!ventaIdActual) return;
        await guardarContrato();
        const btn = document.getElementById('btnGenerarPDF');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generando...';
        window.open(`/ContratoSeminuevos/GenerarPDFContrato?ventaId=${encodeURIComponent(ventaIdActual)}`, '_blank');
        setTimeout(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-file-earmark-pdf-fill me-1"></i>Generar PDF';
        }, 2000);
    }

    /* ── SharePoint ──────────────────────────────────── */
    function abrirModalSharePoint() {
        document.getElementById('spUploadResult').className = 'd-none mt-2';
        document.getElementById('spUploadResult').innerHTML = '';
        const btn = document.getElementById('btnSubirPDFModal');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-1"></i>Generar y subir PDF';
        new bootstrap.Modal(document.getElementById('modalSharePoint')).show();
    }

    async function subirPDF() {
        if (!ventaIdActual) return;
        const btn      = document.getElementById('btnSubirPDFModal');
        const resultEl = document.getElementById('spUploadResult');

        const guardado = await guardarContrato();
        if (!guardado) return;

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Subiendo...';
        resultEl.className = 'd-none mt-2';

        try {
            const credentials = await sharePointService.generateAccessToken();
            constantesSharePoint.ACCESS_TOKEN = credentials.access_token;
            constantesSharePoint.DRIVE_ID     = credentials.driveId;

            const res = await fetch(`/ContratoSeminuevos/GenerarPDFContrato?ventaId=${encodeURIComponent(ventaIdActual)}`);
            if (!res.ok) throw new Error(`Error al generar el PDF (${res.status})`);
            const blob = await res.blob();

            const file = new File([blob], `ContratoSeminuevos_${ventaIdActual}_${Date.now()}.pdf`, { type: 'application/pdf' });
            const resultado = await sharePointService.uploadFile(file, 'Contratos/Seminuevos');

            // ══════════════════ BLOQUE QUE FALTABA ══════════════════
            await fetch('/ContratoSeminuevos/GuardarDocumentoOper', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({
                    idVenta:      parseInt(ventaIdActual),
                    archivo:      resultado.nombre,
                    url:          resultado.url,
                    idSharePoint: resultado.uniqueId,
                    mimeType:     'pdf',
                    tamano:       resultado.tamano
                })
            });
            // ══════════════════════════════════════════════════════

            resultEl.className = 'mt-2';
            resultEl.innerHTML = `
                <div class="alert alert-success py-2 mb-0" style="font-size:.82rem;">
                    <div class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-1"></i>PDF subido correctamente</div>
                    <div class="mb-1"><span class="text-muted">UniqueId:</span> <code class="user-select-all">${resultado.uniqueId}</code></div>
                    <a href="${resultado.url}" target="_blank" class="btn btn-sm btn-outline-success rounded-pill mt-1">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir PDF
                    </a>
                </div>`;
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Subido';

        } catch (e) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:.82rem;">${e.message || 'Error inesperado.'}</div>`;
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-1"></i>Generar y subir PDF';
        }
    }

    async function buscarPorUniqueId() {
        const uniqueId = document.getElementById('inputUniqueId').value.trim();
        const resultEl = document.getElementById('spBuscarResult');
        const btn      = document.getElementById('btnBuscarUniqueId');

        if (!uniqueId) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-warning py-2 mb-0" style="font-size:.82rem;">Ingresa un UniqueId.</div>`;
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        resultEl.className = 'd-none mt-2';

        try {
            if (!constantesSharePoint.ACCESS_TOKEN || !constantesSharePoint.DRIVE_ID) {
                const credentials = await sharePointService.generateAccessToken();
                constantesSharePoint.ACCESS_TOKEN = credentials.access_token;
                constantesSharePoint.DRIVE_ID     = credentials.driveId;
            }

            const res = await fetch(
                `https://graph.microsoft.com/v1.0/drives/${constantesSharePoint.DRIVE_ID}/items/${uniqueId}`,
                { headers: { 'Authorization': `Bearer ${constantesSharePoint.ACCESS_TOKEN}` } }
            );
            if (!res.ok) throw new Error('No encontrado');
            const data = await res.json();
            const url  = data['@@microsoft.graph.downloadUrl'];

            resultEl.className = 'mt-2';
            resultEl.innerHTML = `
                <div class="alert alert-success py-2 mb-0" style="font-size:.82rem;">
                    <div class="fw-bold mb-1"><i class="bi bi-file-earmark-pdf-fill me-1"></i>Archivo encontrado</div>
                    <div class="text-truncate mb-1"><span class="text-muted">Nombre:</span> ${data.name ?? '—'}</div>
                    <a href="${url}" target="_blank" class="btn btn-sm btn-outline-success rounded-pill mt-1">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir PDF
                    </a>
                </div>`;
        } catch (e) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:.82rem;">No se encontró el archivo o el UniqueId es inválido.</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i>';
        }
    }

    /* ── Navegación ──────────────────────────────────── */
    function volverBusqueda() {
        document.getElementById('contratoWrapper').classList.add('d-none');
        document.getElementById('busquedaPanel').classList.remove('d-none');
        document.getElementById('inputVentaId').value = '';
        document.getElementById('busquedaError').classList.add('d-none');
    }

    function mostrarError(msg) {
        const el = document.getElementById('busquedaError');
        el.textContent = msg;
        el.classList.remove('d-none');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const ventaId = params.get('ventaId');
        if (ventaId) {
            document.getElementById('inputVentaId').value = ventaId;
            buscarVenta();
        }
    });
</script>

<script src="~/js/librerias/sharepoint.js"></script>
<script src="~/js/helpers/utils.js"></script>
<script src="~/js/signature/signature_pad.umd.min.js"></script>

