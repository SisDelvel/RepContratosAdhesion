@{
    ViewData["Title"] = "Contrato de Compraventa de Vehículo Usado";
}

<style>
    #contratoWrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    .contrato-band {
        background: linear-gradient(135deg, #1a3a6b 0%, #2563eb 100%);
        color: #fff;
        border-radius: 12px 12px 0 0;
        padding: 1rem 1.5rem;
    }

        .contrato-band .contrato-title {
            font-size: .95rem;
            font-weight: 700;
            line-height: 1.35;
        }

    .sec-label {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #2563eb;
        border-left: 3px solid #2563eb;
        padding-left: .6rem;
        margin: 1.4rem 0 .8rem;
    }

    .form-floating > label {
        font-size: .78rem;
        color: #64748b;
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        font-size: .88rem;
        border-radius: 8px;
    }

        .form-floating > .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }

    .form-control[readonly] {
        background-color: #f8faff;
        color: #374151;
        cursor: default;
    }

    .info-block {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .85rem 1rem;
        margin-bottom: .75rem;
    }

        .info-block .info-block-title {
            font-size: .72rem;
            font-weight: 700;
            color: #1a3a6b;
            margin-bottom: .6rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .monto-total {
        background: #eff6ff;
        border: 2px solid #2563eb;
        border-radius: 8px;
        padding: .5rem .9rem;
        font-size: .9rem;
        font-weight: 700;
        color: #1a3a6b;
    }

    .check-clausula {
        display: flex;
        align-items: flex-start;
        gap: .6rem;
        padding: .4rem .6rem;
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: .3rem;
        font-size: .82rem;
        color: #374151;
        cursor: pointer;
    }

        .check-clausula input[type=checkbox] {
            margin-top: .15rem;
            flex-shrink: 0;
            width: 15px;
            height: 15px;
            accent-color: #2563eb;
            cursor: pointer;
        }

    .clausulas-accordion .accordion-button {
        font-size: .83rem;
        font-weight: 600;
        color: #1a3a6b;
        background: #f8faff;
        border-radius: 8px !important;
        padding: .7rem 1rem;
    }

        .clausulas-accordion .accordion-button:not(.collapsed) {
            background: #eff6ff;
            color: #2563eb;
            box-shadow: none;
        }

    .clausulas-accordion .accordion-item {
        border: 1px solid #e2e8f0;
        border-radius: 8px !important;
        margin-bottom: .5rem;
        overflow: hidden;
    }

    .clausulas-accordion .accordion-body {
        font-size: .83rem;
        color: #374151;
        line-height: 1.65;
        padding: .85rem 1rem;
    }

    .contrato-declaracion {
        background: linear-gradient(135deg, #1a3a6b, #2563eb);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        text-align: center;
        padding: .85rem 1rem;
        border-radius: 8px;
    }

    .firma-row {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .75rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: .5rem;
        flex-wrap: wrap;
    }

        .firma-row .firma-input {
            flex: 1;
            min-width: 200px;
        }

        .firma-row .firma-img {
            min-width: 200px;
            flex: 0 0 220px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .4rem;
        }

    .firma-preview-box {
        width: 200px;
        height: 80px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .firma-preview-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .firma-label-top {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #64748b;
    }

    .garantia-opciones {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        margin-top: .3rem;
    }

        .garantia-opciones .form-check-label {
            font-size: .83rem;
            color: #374151;
        }

    .contrato-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    @@media print {
        .contrato-action-bar {
            display: none !important;
        }

        .contrato-band {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .clausulas-accordion .accordion-collapse {
            display: block !important;
        }
    }
</style>

<!-- ══════════════════ PANEL DE BÚSQUEDA ══════════════════ -->
<div id="busquedaPanel" style="max-width:480px;margin:6rem auto 0;">
    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div style="background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 100%);color:#fff;padding:1.5rem;text-align:center;">
            <div style="font-size:2.4rem;margin-bottom:.5rem;">🔧</div>
            <h5 class="fw-bold mb-0">Orden de Seminuevos</h5>
            <p class="mb-0 mt-1" style="font-size:.82rem;opacity:.85;">Ingresa el ID de orden para cargar el contrato</p>
        </div>
        <div class="card-body p-4">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="inputVentaId"
                       placeholder="ID de Orden" autofocus
                       onkeydown="if(event.key==='Enter') buscarVenta()">
                <label for="inputVentaId">ID de Orden</label>
            </div>
            <div id="busquedaError" class="alert alert-danger d-none py-2" role="alert" style="font-size:.83rem;"></div>
            <button class="btn btn-primary w-100 rounded-pill" onclick="buscarVenta()" id="btnBuscar">
                <i class="bi bi-search me-2"></i>Cargar Orden
            </button>
            <hr class="my-3">
            <p class="mb-2" style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;">
                <i class="bi bi-cloud-fill me-1" style="color:#2563eb;"></i>Buscar PDF en SharePoint
            </p>
            <div class="input-group">
                <input type="text" class="form-control" id="inputUniqueId"
                       placeholder="UniqueId del archivo"
                       style="font-size:.83rem;"
                       onkeydown="if(event.key==='Enter') buscarPorUniqueId()">
                <button class="btn btn-outline-primary" id="btnBuscarUniqueId" onclick="buscarPorUniqueId()">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <div id="spBuscarResult" class="d-none mt-2"></div>
        </div>
    </div>
</div>

<!-- ══════════════════ CONTRATO WRAPPER ══════════════════ -->
<div id="contratoWrapper" class="d-none">

    <div class="contrato-action-bar">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill me-2" style="font-size:.72rem;">SEMINUEVOS</span>
            <span class="fw-semibold">Compraventa de Vehículo Usado</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="volverBusqueda()">
                <i class="bi bi-arrow-left me-1"></i>Cambiar orden
            </button>
            <button class="btn btn-success btn-sm rounded-pill" onclick="guardarContrato()">
                <i class="bi bi-floppy-fill me-1"></i>Guardar
            </button>
            <button class="btn btn-primary btn-sm rounded-pill" id="btnGenerarPDF" onclick="generarPDF()">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Generar PDF
            </button>
            <button class="btn btn-info btn-sm rounded-pill text-white" id="btnSubirSharePoint" onclick="abrirModalSharePoint()">
                <i class="bi bi-cloud-upload-fill me-1"></i>Subir a SharePoint
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">

        <div class="contrato-band">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div style="flex:1;min-width:200px;">
                    <div class="contrato-title mb-2">Contrato de Compraventa de Vehículo Usado</div>
                    <p id="denominacion" class="mb-1" style="font-size:.8rem;font-weight:700;opacity:1;"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;">RFC: <span id="rfcDistribuidora"></span></p>
                    <p id="domicilioDistribuidora" class="mb-1" style="font-size:.75rem;opacity:.85;"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;">Tel: <span id="telefonoDistribuidora"></span></p>
                    <p id="horarioDistribuidora" class="mb-1" style="font-size:.75rem;opacity:.85;"></p>
                    <p class="mb-0" style="font-size:.75rem;opacity:.85;"><span id="correoDistribuidoraHeader"></span></p>
                </div>
                <div style="flex:0 0 180px;border-left:1px solid rgba(255,255,255,.3);padding-left:1rem;">
                    <p class="mb-1" style="font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.7;">Localidad</p>
                    <p id="localidadDistribuidora" class="mb-0" style="font-size:.78rem;"></p>
                </div>
                <div style="min-width:200px;">
                    <div class="form-floating mb-2">
                        <input type="text" readonly class="form-control bg-transparent border-white border-opacity-50"
                               id="folio" placeholder="Folio" style="color:#fff;">
                        <label for="folio" style="color:rgba(255,255,255,.7);">Folio</label>
                    </div>
                    <div class="form-floating">
                        <input type="text" readonly class="form-control bg-transparent border-white border-opacity-50"
                               id="fechaOrden" placeholder="Fecha" style="color:#fff;">
                        <label for="fechaOrden" style="color:rgba(255,255,255,.7);">Fecha</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- ══════ DATOS DEL CLIENTE ══════ -->
            <div class="sec-label">Datos del Cliente (Consumidor)</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="nombreCliente" placeholder="Nombre">
                        <label>Nombre Completo</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="rfcCliente" placeholder="RFC">
                        <label>R.F.C.</label>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="calleCliente" placeholder="Calle">
                        <label>Calle</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="extCliente" placeholder="Ext.">
                        <label>Ext.</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="intCliente" placeholder="Int.">
                        <label>Int.</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="coloniaCliente" placeholder="Colonia">
                        <label>Colonia</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="cpCliente" placeholder="C.P.">
                        <label>C.P.</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="municipioCliente" placeholder="Municipio">
                        <label>Delegación / Municipio</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="estadoCliente" placeholder="Estado">
                        <label>Estado</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="tel" readonly class="form-control" id="telefonoCliente" placeholder="Teléfono">
                        <label>Teléfono(s)</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="email" readonly class="form-control" id="emailCliente" placeholder="Correo">
                        <label>Correo Electrónico</label>
                    </div>
                </div>
            </div>

            <!-- ══════ CARACTERÍSTICAS DEL VEHÍCULO ══════ -->
            <div class="sec-label">Características del Vehículo Usado</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="marca" placeholder="Marca">
                        <label>Marca</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="submarca" placeholder="Submarca">
                        <label>Submarca</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="catalogo" placeholder="Catálogo">
                        <label>Catálogo</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="tipoVersion" placeholder="Tipo / Versión">
                        <label>Tipo / Versión</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="color" placeholder="Color">
                        <label>Color</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="anioModelo" placeholder="Año">
                        <label>Año-Modelo</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="kmRecorridos" placeholder="Km">
                        <label>Kilómetros Recorridos</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="placas" placeholder="Placas">
                        <label>Número de Placas</label>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="niv" placeholder="NIV">
                        <label>Núm. de Identificación Vehicular (NIV)</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="capacidad" placeholder="Capacidad">
                        <label>Capacidad</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="fechaEntrega" placeholder="Fecha de entrega">
                        <label>Fecha y Hora de Entrega</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="lugarEntrega" placeholder="Lugar de entrega">
                        <label>Lugar de Entrega del Vehículo</label>
                    </div>
                </div>
            </div>

            <!-- ══════ MONTO Y FORMA DE PAGO ══════ -->
            <div class="sec-label">Monto de la Operación y Forma de Pago</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-block h-100">
                        <div class="info-block-title">Desglose de la Operación</div>
                        <div class="row g-2">
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Precio del vehículo</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="precioVehiculo" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Precio</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Equipo y accesorios adicionales</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="equipo" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Otros cargos</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="otrosCargos" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Impuesto al valor agregado</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="iva" placeholder="$0.00">
                                    <label style="font-size:.7rem;">IVA</label>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <div class="monto-total d-flex justify-content-between align-items-center">
                                    <span>Monto Total de la Operación</span>
                                    <span id="montoTotalSpan"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 d-flex flex-column gap-3">
                    <div class="info-block mb-0">
                        <div class="info-block-title">Forma de Pago</div>
                        <div class="row g-2">
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Condición</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="condicion" placeholder="—">
                                    <label style="font-size:.7rem;">Condición</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Pago de contado</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="pagoContado" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Enganche / Unidad usada</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="enganche" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="info-block mb-0 flex-grow-1">
                        <div class="info-block-title">Descripción Unidad Usada a Cuenta</div>
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaNiv" placeholder="NIV">
                                    <label style="font-size:.7rem;">Núm. Identificación Vehicular</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaMarca" placeholder="Marca">
                                    <label style="font-size:.7rem;">Marca</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaSubmarca" placeholder="Submarca">
                                    <label style="font-size:.7rem;">Submarca</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaVersion" placeholder="Versión">
                                    <label style="font-size:.7rem;">Tipo / Versión</label>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaColor" placeholder="Color">
                                    <label style="font-size:.7rem;">Color</label>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaAnio" placeholder="Año">
                                    <label style="font-size:.7rem;">Año</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="usadaValor" placeholder="Valor">
                                    <label style="font-size:.7rem;">Valor de la Unidad</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════ TEXTO DEL CONTRATO ══════ -->
            <div class="sec-label mt-4">Texto del Contrato</div>

            <p class="text-muted mb-3" style="font-size:.82rem;">
                El Cliente y el Distribuidor, plenamente capaces de obligarse, manifiestan su voluntad de celebrar el
                presente Contrato de Compraventa de Vehículo Usado, conforme a la Norma Oficial Mexicana NOM-122-SCFI-2010
                y la Ley Federal de Protección al Consumidor, sujeto a las siguientes cláusulas.
            </p>

            <div class="accordion clausulas-accordion" id="acordeonContrato">

                <!-- ── CLÁUSULAS 1–5 ── -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                data-bs-target="#colC1" aria-expanded="true">
                            <i class="bi bi-file-text me-2" style="color:#2563eb;"></i>Cláusulas 1 – 5 — Objeto, Información y Monto
                        </button>
                    </h2>
                    <div id="colC1" class="accordion-collapse collapse show" data-bs-parent="#acordeonContrato">
                        <div class="accordion-body">
