@{
    ViewData["Title"] = "Contrato de Compraventa de Vehículo Nuevo";
}

<style>
    /* ── Wrapper ── */
    #contratoWrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    /* ── Header band ── */
    .contrato-band {
        background: linear-gradient(135deg, #1a3a6b 0%, #2563eb 100%);
        color: #fff;
        border-radius: 12px 12px 0 0;
        padding: 1rem 1.5rem;
    }

        .contrato-band .folio-badge {
            font-size: .68rem;
            background: rgba(255,255,255,.2);
            border-radius: 20px;
            padding: 2px 10px;
            letter-spacing: .04em;
            display: inline-block;
            margin-bottom: .3rem;
        }

        .contrato-band .contrato-title {
            font-size: .95rem;
            font-weight: 700;
            line-height: 1.35;
        }

        .contrato-band .contrato-subtitle {
            font-size: .75rem;
            opacity: .8;
            margin-top: .2rem;
        }

    /* ── Section label ── */
    .sec-label {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #2563eb;
        border-left: 3px solid #2563eb;
        padding-left: .6rem;
        margin: 1.4rem 0 .8rem;
    }

    /* ── Floating label tweaks ── */
    .form-floating > label {
        font-size: .78rem;
        color: #64748b;
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        font-size: .88rem;
        border-radius: 8px;
    }

        .form-floating > .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }

    /* ── Readonly look ── */
    .form-control[readonly] {
        background-color: #f8faff;
        color: #374151;
        cursor: default;
    }

    /* ── Info block ── */
    .info-block {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .85rem 1rem;
        margin-bottom: .75rem;
    }

        .info-block .info-block-title {
            font-size: .72rem;
            font-weight: 700;
            color: #1a3a6b;
            margin-bottom: .6rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    /* ── Acordeón de cláusulas ── */
    .clausulas-accordion .accordion-button {
        font-size: .83rem;
        font-weight: 600;
        color: #1a3a6b;
        background: #f8faff;
        border-radius: 8px !important;
        padding: .7rem 1rem;
    }

        .clausulas-accordion .accordion-button:not(.collapsed) {
            background: #eff6ff;
            color: #2563eb;
            box-shadow: none;
        }

        .clausulas-accordion .accordion-button::after {
            filter: none;
        }

    .clausulas-accordion .accordion-item {
        border: 1px solid #e2e8f0;
        border-radius: 8px !important;
        margin-bottom: .5rem;
        overflow: hidden;
    }

    .clausulas-accordion .accordion-body {
        font-size: .83rem;
        color: #374151;
        line-height: 1.65;
        padding: .85rem 1rem;
    }

    /* ── Firma row (igual que FIC) ── */
    .firma-row {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .75rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: .5rem;
        flex-wrap: wrap;
    }

        .firma-row .firma-input {
            flex: 1;
            min-width: 200px;
        }

        .firma-row .firma-pad {
            min-width: 200px;
            flex: 0 0 220px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .4rem;
        }

    .firma-preview {
        width: 200px;
        height: 80px;
        border: 1.5px dashed #cbd5e1;
        border-radius: 8px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
        transition: border-color .2s;
    }

        .firma-preview:hover {
            border-color: #2563eb;
        }

        .firma-preview img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .firma-preview .firma-placeholder {
            font-size: .72rem;
            color: #94a3b8;
            text-align: center;
            padding: .5rem;
        }

    .firma-label-top {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #64748b;
    }

    /* ── Declaración banner ── */
    .contrato-declaracion {
        background: linear-gradient(135deg, #1a3a6b, #2563eb);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        text-align: center;
        padding: .85rem 1rem;
        border-radius: 8px;
    }

    /* ── Action bar ── */
    .contrato-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    /* ── Monto highlight ── */
    .monto-total {
        background: #eff6ff;
        border: 2px solid #2563eb;
        border-radius: 8px;
        padding: .5rem .9rem;
        font-size: .9rem;
        font-weight: 700;
        color: #1a3a6b;
    }

    /* ── Datos personales radio ── */
    .datos-personales-opciones {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        margin-top: .3rem;
    }

        .datos-personales-opciones .form-check-label {
            font-size: .83rem;
            color: #374151;
            cursor: pointer;
        }

    /* ── Print ── */
    @@media print {
        .contrato-action-bar {
            display: none !important;
        }

        .contrato-band {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .clausulas-accordion .accordion-collapse {
            display: block !important;
        }
    }
</style>

<!-- ══════════════════ PANEL DE BÚSQUEDA ══════════════════ -->
<div id="busquedaPanel" style="max-width:480px;margin:6rem auto 0;">
    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div style="background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 100%);color:#fff;padding:1.5rem;text-align:center;">
            <div style="font-size:2.4rem;margin-bottom:.5rem;">📄</div>
            <h5 class="fw-bold mb-0">Contrato de Compraventa</h5>
            <p class="mb-0 mt-1" style="font-size:.82rem;opacity:.85;">Ingresa el ID de venta para cargar el contrato</p>
        </div>
        <div class="card-body p-4">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="inputVentaId"
                       placeholder="ID de Venta" autofocus
                       onkeydown="if(event.key==='Enter') buscarVenta()">
                <label for="inputVentaId">ID de Venta</label>
            </div>
            <div id="busquedaError" class="alert alert-danger d-none py-2" role="alert" style="font-size:.83rem;"></div>
            <button class="btn btn-primary w-100 rounded-pill" onclick="buscarVenta()" id="btnBuscar">
                <i class="bi bi-search me-2"></i>Cargar Contrato
            </button>

            <hr class="my-3">

            <!-- Buscar PDF en SharePoint por UniqueId -->
            <p class="mb-2" style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;">
                <i class="bi bi-cloud-fill me-1" style="color:#2563eb;"></i>Buscar PDF en SharePoint
            </p>
            <div class="input-group">
                <input type="text" class="form-control" id="inputUniqueId"
                       placeholder="UniqueId del archivo"
                       style="font-size:.83rem;"
                       onkeydown="if(event.key==='Enter') buscarPorUniqueId()">
                <button class="btn btn-outline-primary" id="btnBuscarUniqueId" onclick="buscarPorUniqueId()">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <div id="spBuscarResult" class="d-none mt-2"></div>
        </div>
    </div>
</div>

<!-- ══════════════════ CONTRATO WRAPPER ══════════════════ -->
<div id="contratoWrapper" class="d-none">

    <!-- Action bar -->
    <div class="contrato-action-bar">
        <div>
            <span id="contratoBadgeTop" class="badge bg-primary-subtle text-primary rounded-pill me-2" style="font-size:.72rem;">CONTRATO</span>
            <span class="fw-semibold">Compraventa de Vehículo Nuevo</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="volverBusqueda()">
                <i class="bi bi-arrow-left me-1"></i>Cambiar venta
            </button>
            <button class="btn btn-success btn-sm rounded-pill" onclick="guardarContrato()">
                <i class="bi bi-floppy-fill me-1"></i>Guardar
            </button>
            <button class="btn btn-primary btn-sm rounded-pill" id="btnGenerarPDF" onclick="generarPDF()">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Generar PDF
            </button>
            <button class="btn btn-info btn-sm rounded-pill text-white" id="btnSubirSharePoint" onclick="abrirModalSharePoint()">
                <i class="bi bi-cloud-upload-fill me-1"></i>Subir a SharePoint
            </button>
        </div>
    </div>

    <!-- Card principal -->
    <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">

        <!-- Band header -->
        <div class="contrato-band">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">

                <!-- Distribuidora -->
                <div style="flex:1;min-width:200px;">
                    <div class="contrato-title mb-2">Contrato de Compraventa de Vehículo Nuevo Automotor</div>
                    <p id="denominacion" class="mb-1" style="font-size:.8rem;font-weight:700;opacity:1;"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;">
                        RFC: <span id="rfcDistribuidora"></span>
                    </p>
                    <p id="domicilioDistribuidora" class="mb-1" style="font-size:.75rem;opacity:.85;"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;">
                        Tel: <span id="telefonoDistribuidora"></span>
                    </p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;">Lunes a Viernes 9:00–19:00 hrs, Sábado 9:00–14:00 hrs</p>
                    <p class="mb-0" style="font-size:.75rem;opacity:.85;">
                        <span id="dist_correo_header"></span>
                    </p>
                </div>

                <!-- Localidad -->
                <div style="flex:0 0 180px;border-left:1px solid rgba(255,255,255,.3);padding-left:1rem;">
                    <p class="mb-1" style="font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.7;">Localidad</p>
                    <p id="localidadEntrega" class="mb-0" style="font-size:.78rem;"></p>
                </div>

                <!-- Folio / Fecha -->
                <div style="min-width:200px;">
                    <div class="form-floating mb-2">
                        <input type="text" readonly class="form-control bg-transparent border-white border-opacity-50"
                               id="folio" name="folio" placeholder="Folio" style="color:#fff;">
                        <label for="folio" style="color:rgba(255,255,255,.7);">Folio</label>
                    </div>
                    <div class="form-floating">
                        <input type="date" readonly class="form-control bg-transparent border-white border-opacity-50"
                               id="fechaContrato" name="fechaContrato" placeholder="Fecha" style="color:#fff;">
                        <label for="fechaContrato" style="color:rgba(255,255,255,.7);">Fecha del Contrato</label>
                    </div>
                </div>

            </div>
        </div>

        <div class="card-body p-4">

            <!-- ══════ SECCIÓN 2: DATOS DEL CLIENTE ══════ -->
            <div class="sec-label">Datos del Cliente (Consumidor)</div>
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="nombreCliente" name="nombreCliente" placeholder="Nombre">
                        <label for="nombreCliente">Nombre Completo</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="rfcCliente" name="rfcCliente" placeholder="RFC">
                        <label for="rfcCliente">R.F.C.</label>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="calleCliente" name="calleCliente" placeholder="Calle">
                        <label for="calleCliente">Calle</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="extCliente" name="extCliente" placeholder="Ext.">
                        <label for="extCliente">Ext.</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="intCliente" name="intCliente" placeholder="Int.">
                        <label for="intCliente">Int.</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="coloniaCliente" name="coloniaCliente" placeholder="Colonia">
                        <label for="coloniaCliente">Colonia</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="cpCliente" name="cpCliente" placeholder="C.P.">
                        <label for="cpCliente">C.P.</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="municipioCliente" name="municipioCliente" placeholder="Municipio">
                        <label for="municipioCliente">Delegación / Municipio</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="estadoCliente" name="estadoCliente" placeholder="Estado">
                        <label for="estadoCliente">Estado</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="tel" readonly class="form-control" id="telefonoCliente" name="telefonoCliente" placeholder="Teléfono">
                        <label for="telefonoCliente">Teléfono(s)</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="email" readonly class="form-control" id="emailCliente" name="emailCliente" placeholder="Correo">
                        <label for="emailCliente">Correo Electrónico</label>
                    </div>
                </div>
            </div>

            <!-- ══════ SECCIÓN 3: CARACTERÍSTICAS DEL VEHÍCULO ══════ -->
            <div class="sec-label">Características del Vehículo</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="marca" name="marca" placeholder="Marca">
                        <label for="marca">Marca</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="submarca" name="submarca" placeholder="Submarca">
                        <label for="submarca">Submarca</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="catalogo" name="catalogo" placeholder="Catálogo">
                        <label for="catalogo">Catálogo</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="tipoVersion" name="tipoVersion" placeholder="Tipo / Versión">
                        <label for="tipoVersion">Tipo / Versión</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="color" name="color" placeholder="Color">
                        <label for="color">Color</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="anioModelo" name="anioModelo" placeholder="Año-Modelo">
                        <label for="anioModelo">Año-Modelo</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="capacidad" name="capacidad" placeholder="Capacidad">
                        <label for="capacidad">Capacidad</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="date" class="form-control" id="fechaEntrega" name="fechaEntrega" placeholder="Fecha de Entrega">
                        <label for="fechaEntrega">Fecha de Entrega</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="niv" name="niv" placeholder="NIV">
                        <label for="niv">Número de Identificación Vehicular (NIV)</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating">
                        <input type="text" readonly class="form-control" id="lugarEntrega" name="lugarEntrega" placeholder="Lugar de Entrega">
                        <label for="lugarEntrega">Lugar de Entrega del Vehículo</label>
                    </div>
                </div>
            </div>

            <!-- ══════ SECCIÓN 4: MONTO Y FORMA DE PAGO ══════ -->
            <div class="sec-label">Monto de la Operación y Forma de Pago</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-block h-100">
                        <div class="info-block-title">Desglose de la Operación</div>
                        <div class="row g-2">
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Precio del vehículo</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="precioVehiculo" name="precioVehiculo" placeholder="$0.00">
                                    <label for="precioVehiculo" style="font-size:.7rem;">Precio</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Equipo y accesorios adicionales</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="precioEquipo" name="precioEquipo" placeholder="$0.00">
                                    <label for="precioEquipo" style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Otros cargos</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="otrosCargos" name="otrosCargos" placeholder="$0.00">
                                    <label for="otrosCargos" style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Impuestos al valor agregado</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="iva" name="iva" placeholder="$0.00">
                                    <label for="iva" style="font-size:.7rem;">IVA</label>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <div class="monto-total d-flex justify-content-between align-items-center">
                                    <span>Monto Total de la Operación</span>
                                    <span id="montoTotal"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block h-100">
                        <div class="info-block-title">Forma de Pago</div>
                        <div class="row g-2">
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Contado</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="pagoContado" name="pagoContado" placeholder="$0.00">
                                    <label for="pagoContado" style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Enganche o Unidad usada a cuenta</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control form-control-sm" id="enganche" name="enganche" placeholder="$0.00">
                                    <label for="enganche" style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating mt-1">
                                    <textarea class="form-control" id="descripcionPago" name="descripcionPago"
                                              placeholder="Descripción" style="height:80px;font-size:.83rem;"></textarea>
                                    <label for="descripcionPago">Ver Descripción / Observaciones de Pago</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Equipo y accesorios + Unidad usada -->
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title">Equipo y Accesorios Adicionales</div>
                        <div class="form-floating">
                            <textarea class="form-control" id="equipoAdicional" name="equipoAdicional"
                                      placeholder="Detalle" style="height:80px;font-size:.83rem;"></textarea>
                            <label for="equipoAdicional">Detalle de Equipo y Accesorios</label>
                        </div>
                        <div class="form-floating mt-2">
                            <input type="text" readonly class="form-control" id="totalEquipo" name="totalEquipo" placeholder="Total equipo">
                            <label for="totalEquipo">Total Equipo y Accesorios Adicionales</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="info-block-title">Descripción Unidad Usada (si aplica)</div>
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control" id="usadaNiv" name="usadaNiv" placeholder="NIV">
                                    <label for="usadaNiv">Número de Identificación Vehicular</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating">
                                    <input type="text" readonly class="form-control" id="usadaMarca" name="usadaMarca" placeholder="Marca">
                                    <label for="usadaMarca">Marca</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating">
