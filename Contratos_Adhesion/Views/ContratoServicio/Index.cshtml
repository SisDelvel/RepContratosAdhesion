    function updateFuelGauge(value) {
        document.getElementById('fuelSlider').value = value;
        const rotation = -90 + (value / 100) * 180;
        document.getElementById('fuelNeedle').setAttribute('transform', `rotate(${rotation}, 0, 0)`);
