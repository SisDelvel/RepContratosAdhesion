    // ══════════════════════════════════════════════════════
    // DAÑOS
    // ══════════════════════════════════════════════════════
    let damages = [];
    let selectedDamageType = 'golpe';

    const damageConfig = {
        golpe: { color: '#dc3545', label: 'X',  text: 'Golpe' },
        rayon: { color: '#fd7e14', label: '~',  text: 'Rayón' }
    };

    function selectDamageType(type, btn) {
        selectedDamageType = type;
        document.querySelectorAll('#damageTypeButtons .btn').forEach(b => b.classList.remove('bg-primary','bg-opacity-10'));
        btn.classList.add('bg-primary','bg-opacity-10');
    }

    function handleCanvasClick(event) {
        const canvas = document.getElementById('vehicleCanvas');
        const rect   = canvas.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top)  / rect.height;
        addDamage(x, y);
    }

    function addDamage(x, y) {
        const id     = `${Date.now()}-${Math.random()}`;
        const damage = { id, type: selectedDamageType, x, y };
        damages.push(damage);
        renderDamageMarkers(damage);
        renderDamageList();
        actualizarResumenBadges();
    }

    function renderDamageMarkers(damage) {
        const cfg = damageConfig[damage.type];

        ['vehicleCanvas', 'vehicleCanvasPage'].forEach(canvasId => {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;

            const insertar = () => {
                const prev = document.getElementById(`marker-${damage.id}-${canvasId}`);
                if (prev) prev.remove();

                const marker = document.createElement('div');
                marker.id        = `marker-${damage.id}-${canvasId}`;
                marker.className = 'damage-marker';
                marker.style.cssText = [
                    'position:absolute',
                    `left:${damage.x * 100}%`,
                    `top:${damage.y * 100}%`,
                    'transform:translate(-50%,-50%)',
                    'width:26px', 'height:26px',
                    'border-radius:50%',
                    'display:flex', 'align-items:center', 'justify-content:center',
                    'font-weight:bold', 'color:white',
                    'border:2px solid white',
                    'box-shadow:0 2px 4px rgba(0,0,0,.3)',
                    'cursor:pointer', 'font-size:13px', 'z-index:10',
                    `background:${cfg.color}`,
                    'pointer-events:auto', 'user-select:none'
                ].join(';');
                marker.textContent = cfg.label;
                marker.title       = `${cfg.text} — clic para eliminar`;
                marker.onclick     = (e) => { e.stopPropagation(); removeDamage(damage.id); };
                canvas.appendChild(marker);
            };

            const img = canvas.querySelector('img');
            if (!img || img.complete) insertar();
            else img.addEventListener('load', insertar, { once: true });
        });
    }

    function removeDamage(id) {
        damages = damages.filter(d => d.id !== id);
        ['vehicleCanvas', 'vehicleCanvasPage'].forEach(canvasId => {
            const marker = document.getElementById(`marker-${id}-${canvasId}`);
            if (marker) marker.remove();
        });
        renderDamageList();
        actualizarResumenBadges();
    }

    function renderDamageList() {
        const list  = document.getElementById('damageList');
        const noMsg = document.getElementById('noDamagesMsg');
        if (!list) return;
        if (damages.length === 0) {
            list.querySelectorAll('.damage-list-item').forEach(el => el.remove());
            if (noMsg) noMsg.classList.remove('d-none');
            return;
        }
        if (noMsg) noMsg.classList.add('d-none');
        list.querySelectorAll('.damage-list-item').forEach(el => el.remove());
        damages.forEach(d => {
            const cfg  = damageConfig[d.type];
            const item = document.createElement('div');
            item.className = 'damage-list-item d-flex align-items-center gap-2 border rounded p-2 bg-light mb-2';
            item.innerHTML = `
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center"
                     style="width:24px;height:24px;background:${cfg.color};font-size:11px;font-weight:bold;flex-shrink:0;">
                    ${cfg.label}
                </div>
                <div class="flex-grow-1">
                    <div class="small fw-medium">${cfg.text}</div>
                    <div class="small text-muted">Pos: ${(d.x * 100).toFixed(1)}%, ${(d.y * 100).toFixed(1)}%</div>
                </div>
                <button class="btn btn-sm p-0 text-muted" style="width:28px;height:28px;"
                        onclick="removeDamage('${d.id}')">
                    <i class="bi bi-x"></i>
                </button>`;
            list.appendChild(item);
        });
    }

    function limpiarDanos() {
        damages = [];
        ['vehicleCanvas', 'vehicleCanvasPage'].forEach(canvasId => {
            const canvas = document.getElementById(canvasId);
            if (canvas) canvas.querySelectorAll('[id^="marker-"]').forEach(m => m.remove());
        });
        renderDamageList();
        actualizarResumenBadges();
    }

    function actualizarResumenBadges() {
        const el = document.getElementById('danosResumenBadges');
        if (!el) return;
        if (damages.length === 0) { el.innerHTML = ''; return; }
        const conteo = {};
        damages.forEach(d => { conteo[d.type] = (conteo[d.type] || 0) + 1; });
        el.innerHTML = Object.entries(conteo).map(([type, count]) =>
            `<span class="badge" style="background:${damageConfig[type].color};font-size:.65rem;">
                ${damageConfig[type].label}: ${count}
             </span>`
        ).join(' ');
    }

    function limpiarFormulario() {
        document.querySelectorAll('#ordenWrapper input[type="text"], #ordenWrapper input[type="email"], #ordenWrapper input[type="tel"], #ordenWrapper textarea')
            .forEach(el => el.value = '');
        document.querySelectorAll('#ordenWrapper input[type="checkbox"]')
            .forEach(el => el.checked = false);

        ['hdr_denominacion','hdr_domicilio','hdr_rfc','hdr_telefono','hdr_horario','hdr_correo','hdr_localidad']
            .forEach(id => { const el = document.getElementById(id); if (el) el.textContent = ''; });

        const nombreFirma = document.getElementById('nombreClienteFirma');
        if (nombreFirma) nombreFirma.textContent = '';

        const montoTotalPago = document.getElementById('montoTotalPago');
        if (montoTotalPago) montoTotalPago.textContent = '';

        llenarTablaOperaciones([]);
        updateFuelGauge(50);
        limpiarDanos();

        ['firmaDistribuidor', 'firmaCliente', 'firmaExtra'].forEach(nombre => {
            const padEl = document.getElementById(`pad_${nombre}`);
            const rehEl = document.getElementById(`rehacer_${nombre}`);
            if (!padEl) return;
            padEl.innerHTML = `<div class="firma-placeholder"><i class="bi bi-pen d-block mb-1" style="font-size:1.2rem;"></i>Toca para firmar</div>`;
            padEl.onclick = () => abrirFirma(nombre);
            padEl.style.cursor = 'pointer';
            padEl.style.borderStyle = 'dashed';
            padEl.style.borderColor = '#cbd5e1';
            if (rehEl) rehEl.classList.add('d-none');
        });
    }
</script>

