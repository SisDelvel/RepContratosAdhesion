            partesEntregaNo:     chk('chkNo'),
            partesGarantia:      chk('chkGarantia'),
            partesResiduos:      chk('chkResiduos'),
            servicioDomicilioSi: chk('chkDomSi'),
            servicioDomicilioNo: chk('chkDomNo'),
            polizaSeguros:       chk('chkPolSi'),
            polizaNoSeguros:     chk('chkPolNo'),

            anticipo:      val('anticipo'),
            conductor:     val('conductor'),
            medioContacto: val('medioContacto'),
            telContacto:   val('telContacto'),
            fechaDofu:     val('fechaDofu'),
            katashiki:     val('katashiki'),
            deseaContacto: chk('chkContactadoSi'),

            firmaDistribuidor: obtenerFirmaBase64('firmaDistribuidor'),
            firmaCliente:      obtenerFirmaBase64('firmaCliente'),
            firmaExtra:        obtenerFirmaBase64('firmaExtra'),

            danos: damages.map(d => ({
                idTipoDano: d.type === 'golpe' ? 1 : 2,
                coordX:     d.x,
                coordY:     d.y
            })),
            danosJson: JSON.stringify(damages.map(d => ({ type: d.type, x: d.x, y: d.y })))
        };

        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

        try {
            const res = await fetch('/ContratoServicio/GuardarContrato', {
                method: 'POST',
                headers: {
                    'Content-Type':     'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.mensaje || `Error al guardar (${res.status})`);
            }
            mostrarToast('Contrato guardado correctamente.', 'success');
        } catch (e) {
            mostrarToast(e.message || 'Error al guardar.', 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-floppy-fill me-1"></i>Guardar';
        }
    }

    function mostrarToast(msg, tipo) {
        let container = document.getElementById('toastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem;';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        toast.className = `alert alert-${tipo} shadow mb-0 py-2 px-3`;
        toast.style.cssText = 'font-size:.85rem;min-width:220px;';
        toast.textContent = msg;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3500);
    }

