<script>
    let ventaIdActual       = null;

    const constantesSharePoint = { DRIVE_ID: '', ACCESS_TOKEN: '' };

    // ══════════════════════════════════════════════════════
    // PDF
    // ══════════════════════════════════════════════════════
    async function generarPDF() {
        if (!ventaIdActual) return;
        await guardarContrato();
        window.open(`/ContratoServicio/GenerarPDF?idServicio=${encodeURIComponent(ventaIdActual)}`, '_blank');
    }

    // ══════════════════════════════════════════════════════
    // SHAREPOINT
    // ══════════════════════════════════════════════════════
    function abrirModalSharePoint() {
        document.getElementById('spUploadResult').className = 'd-none mt-2';
        document.getElementById('spUploadResult').innerHTML = '';
        const btn = document.getElementById('btnSubirPDFModal');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-1"></i>Generar y subir PDF';
        new bootstrap.Modal(document.getElementById('modalSharePoint')).show();
    }

    async function subirPDF() {
        if (!ventaIdActual) return;

        const btn      = document.getElementById('btnSubirPDFModal');
        const resultEl = document.getElementById('spUploadResult');

        await guardarContrato();

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Subiendo...';
        resultEl.className = 'd-none mt-2';

        try {
            const credentials = await sharePointService.generateAccessToken();
            constantesSharePoint.ACCESS_TOKEN = credentials.access_token;
            constantesSharePoint.DRIVE_ID     = credentials.driveId;

            const res = await fetch(`/ContratoServicio/GenerarPDF?idServicio=${encodeURIComponent(ventaIdActual)}`);
            if (!res.ok) throw new Error(`Error al generar el PDF (${res.status})`);
            const blob = await res.blob();

            const nombreArchivo = `ContratoServicio_${ventaIdActual}_${Date.now()}.pdf`;
            const file = new File([blob], nombreArchivo, { type: 'application/pdf' });

            const resultado = await sharePointService.uploadFile(file, 'Contratos/Servicio');

            // ── Guardar metadata del documento en el nuevo modelo (tablas Oper) ──
            await fetch('/ContratoServicio/GuardarDocumentoOper', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({
                    idVenta:      parseInt(ventaIdActual),
                    archivo:      resultado.nombre,
                    url:          resultado.url,
                    idSharePoint: resultado.uniqueId,
                    mimeType:     'pdf',
                    tamano:       resultado.tamano
                })
            });

            await guardarContrato();

            resultEl.className = 'mt-2';
            resultEl.innerHTML = `
                <div class="alert alert-success py-2 mb-0" style="font-size:.82rem;">
                    <div class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-1"></i>PDF subido correctamente</div>
                    <div class="mb-1">
                        <span class="text-muted">UniqueId:</span>
                        <code class="user-select-all">${resultado.uniqueId}</code>
                    </div>
                    <a href="${resultado.url}" target="_blank" class="btn btn-sm btn-outline-success rounded-pill mt-1">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir PDF
                    </a>
                </div>`;

            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Subido';

        } catch (e) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:.82rem;">${e.message || 'Error inesperado.'}</div>`;
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-1"></i>Generar y subir PDF';
        }
    }

    async function buscarPorUniqueId() {
        const uniqueId = document.getElementById('inputUniqueId').value.trim();
        const resultEl = document.getElementById('spBuscarResult');
        const btn      = document.getElementById('btnBuscarUniqueId');

        if (!uniqueId) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-warning py-2 mb-0" style="font-size:.82rem;">Ingresa un UniqueId.</div>`;
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        resultEl.className = 'd-none mt-2';

        try {
            if (!constantesSharePoint.ACCESS_TOKEN || !constantesSharePoint.DRIVE_ID) {
                const credentials = await sharePointService.generateAccessToken();
                constantesSharePoint.ACCESS_TOKEN = credentials.access_token;
                constantesSharePoint.DRIVE_ID     = credentials.driveId;
            }

            const res = await fetch(
                `https://graph.microsoft.com/v1.0/drives/${constantesSharePoint.DRIVE_ID}/items/${uniqueId}`,
                { headers: { 'Authorization': `Bearer ${constantesSharePoint.ACCESS_TOKEN}` } }
            );
            if (!res.ok) throw new Error('No encontrado');
            const data = await res.json();
            const url  = data['@@microsoft.graph.downloadUrl'];

            resultEl.className = 'mt-2';
            resultEl.innerHTML = `
                <div class="alert alert-success py-2 mb-0" style="font-size:.82rem;">
                    <div class="fw-bold mb-1"><i class="bi bi-file-earmark-pdf-fill me-1"></i>Archivo encontrado</div>
                    <div class="text-truncate mb-1"><span class="text-muted">Nombre:</span> ${data.name ?? '—'}</div>
                    <a href="${url}" target="_blank" class="btn btn-sm btn-outline-success rounded-pill mt-1">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir PDF
                    </a>
                </div>`;
        } catch (e) {
            resultEl.className = 'mt-2';
            resultEl.innerHTML = `<div class="alert alert-danger py-2 mb-0" style="font-size:.82rem;">No se encontró el archivo o el UniqueId es inválido.</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i>';
        }
    }

    // ══════════════════════════════════════════════════════
    // NAVEGACIÓN
    // ══════════════════════════════════════════════════════
    function volverBusqueda() {
        document.getElementById('ordenWrapper').classList.add('d-none');
        document.getElementById('busquedaPanel').classList.remove('d-none');
        document.getElementById('inputVentaId').value = '';
        document.getElementById('busquedaError').classList.add('d-none');
    }

    function mostrarError(msg) {
        const el = document.getElementById('busquedaError');
        el.textContent = msg;
        el.classList.remove('d-none');
    }

    // ══════════════════════════════════════════════════════
    // BUSCAR ORDEN
    // ══════════════════════════════════════════════════════
    async function buscarOrden() {
        const id = document.getElementById('inputVentaId').value.trim();
        if (!id) return mostrarError('Ingresa un número de orden.');

        const btn   = document.getElementById('btnBuscar');
        const errEl = document.getElementById('busquedaError');
        errEl.classList.add('d-none');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Cargando...';

        try {
            const res = await fetch(`/ContratoServicio/ObtenerDatos?idServicio=${encodeURIComponent(id)}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.mensaje || `Error al obtener los datos (${res.status}).`);
            }

            const dto = await res.json();
            ventaIdActual = id;
            llenarCampos(dto);

            document.getElementById('busquedaPanel').classList.add('d-none');
            document.getElementById('ordenWrapper').classList.remove('d-none');

        } catch (e) {
            mostrarError(e.message || 'Error inesperado.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search me-2"></i>Cargar Orden';
        }
    }

    // ══════════════════════════════════════════════════════
    // GUARDAR CONTRATO
    // ══════════════════════════════════════════════════════
    async function guardarContrato() {
        if (!ventaIdActual) return;

        const chk = (id) => document.getElementById(id)?.checked ?? false;
        const val = (id) => document.getElementById(id)?.value ?? '';
        const obtenerFirmaBase64 = (nombre) => {
            const img = document.querySelector(`#pad_${nombre} img`);
            return img ? img.src : null;
        };

        const payload = {
            idVenta: parseInt(ventaIdActual),

            invTapetes:        chk('invTapetes'),
            invCeniceros:      chk('invCeniceros'),
            invBocinas:        chk('invBocinas'),
            invInstrumentos:   chk('invInstrumentos'),
            invEncendedores:   chk('invEncendedores'),
            invRadio:          chk('invRadio'),
            invClaxon:         chk('invClaxon'),
            invAC:             chk('invAC'),
            invRetrovisor:     chk('invRetrovisor'),
            invManijas:        chk('invManijas'),
            invVestiduras:     chk('invVestiduras'),
            invCinturones:     chk('invCinturones'),
            invManualProp:     chk('invManualProp'),
            invCarnetServicio: chk('invCarnetServicio'),

            invTarjetaCirculacion: chk('invTarjetaCirculacion'),
            invPolizaSeguro:       chk('invPolizaSeguro'),
            invVerificacion:       chk('invVerificacion'),
            invAlfombradoCaj:      chk('invAlfombradoCaj'),
            invLlantaRefaccion:    chk('invLlantaRefaccion'),
            invTriangulos:         chk('invTriangulos'),
            invExtintor:           chk('invExtintor'),
            invCablesBateria:      chk('invCablesBateria'),
            invGato:               chk('invGato'),
            invHerramientas:       chk('invHerramientas'),
            invBotiquin:           chk('invBotiquin'),
            invRedProtectora:      chk('invRedProtectora'),
            invBirloSeguridad:     chk('invBirloSeguridad'),

            extCristales:       chk('extCristales'),
            extLimpiadores:     chk('extLimpiadores'),
            extTapones:         chk('extTapones'),
            extFarosNiebla:     chk('extFarosNiebla'),
            extAntena:          chk('extAntena'),
            extTaponGas:        chk('extTaponGas'),
            extMolduras:        chk('extMolduras'),
            extEspejos:         chk('extEspejos'),
            extFarosDelanteros: chk('extFarosDelanteros'),
            extLucesTraseras:   chk('extLucesTraseras'),
            extGolpes:          chk('extGolpes'),

            testLlantas:            chk('testLlantas'),
            testCheckEngine:        chk('testCheckEngine'),
            testVscrack:            chk('testVscrack'),
            testPresionAceite:      chk('testPresionAceite'),
            testControlEstabilidad: chk('testControlEstabilidad'),
            testBolsasAire:         chk('testBolsasAire'),
            testBateria:            chk('testBateria'),
            testTemperatura:        chk('testTemperatura'),

            nivelGasolina: parseInt(document.getElementById('fuelSlider')?.value ?? '50'),

            c5ExtLimpiaparabrisas: chk('chkC5ExtLimpiaparabrisas'),
            c5ExtLuces:            chk('chkC5ExtLuces'),
            c5ExtAntena:           chk('chkC5ExtAntena'),
            c5ExtEspejos:          chk('chkC5ExtEspejos'),
            c5ExtCristales:        chk('chkC5ExtCristales'),
            c5ExtTapones:          chk('chkC5ExtTapones'),
            c5ExtMolduras:         chk('chkC5ExtMolduras'),
            c5ExtTaponGas:         chk('chkC5ExtTaponGas'),
            c5ExtClaxon:           chk('chkC5ExtClaxon'),

            c5IntInstrumentos: chk('chkC5IntInstrumentos'),
            c5IntCalefaccion:  chk('chkC5IntCalefaccion'),
            c5IntAire:         chk('chkC5IntAire'),
            c5IntRadio:        chk('chkC5IntRadio'),
            c5IntBocinas:      chk('chkC5IntBocinas'),
            c5IntEncendedor:   chk('chkC5IntEncendedor'),
            c5IntEspejoRet:    chk('chkC5IntEspejoRet'),
            c5IntCeniceros:    chk('chkC5IntCeniceros'),
