@{
    ViewData["Title"] = "Orden de Servicio";
}

<style>
    #ordenWrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    .orden-band {
        background: linear-gradient(135deg, #1a3a6b 0%, #2563eb 100%);
        color: #fff;
        border-radius: 12px 12px 0 0;
        padding: 1rem 1.5rem;
    }

        .orden-band .orden-title {
            font-size: .95rem;
            font-weight: 700;
            line-height: 1.35;
        }

    .sec-label {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #2563eb;
        border-left: 3px solid #2563eb;
        padding-left: .6rem;
        margin: 1.4rem 0 .8rem;
    }

    .form-floating > label {
        font-size: .78rem;
        color: #64748b;
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        font-size: .88rem;
        border-radius: 8px;
    }

        .form-floating > .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12);
        }

    .info-block {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .85rem 1rem;
        margin-bottom: .75rem;
    }

        .info-block .info-block-title {
            font-size: .72rem;
            font-weight: 700;
            color: #1a3a6b;
            margin-bottom: .6rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .check-clausula {
        display: flex;
        align-items: flex-start;
        gap: .6rem;
        padding: .5rem .75rem;
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        margin-bottom: .5rem;
        font-size: .83rem;
        color: #374151;
    }

        .check-clausula input[type=checkbox] {
            margin-top: .15rem;
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            accent-color: #2563eb;
        }

    .inventario-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .8rem;
    }

        .inventario-table th {
            background: #1a3a6b;
            color: #fff;
            padding: .35rem .5rem;
            text-align: center;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .inventario-table td {
            padding: .25rem .5rem;
            border: 1px solid #e2e8f0;
            vertical-align: top;
        }

        .inventario-table .chk-row {
            display: flex;
            align-items: center;
            gap: .4rem;
            padding: .15rem 0;
            font-size: .78rem;
        }

            .inventario-table .chk-row input[type="checkbox"] {
                flex-shrink: 0;
                cursor: pointer;
            }

    .coches-img {
        width: 100%;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .orden-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .firma-row {
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: .75rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: .5rem;
        flex-wrap: wrap;
    }

        .firma-row .firma-input {
            flex: 1;
            min-width: 200px;
        }

        .firma-row .firma-pad {
            min-width: 200px;
            flex: 0 0 220px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .4rem;
        }

    .firma-preview {
        width: 200px;
        height: 80px;
        border: 1.5px dashed #cbd5e1;
        border-radius: 8px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
        transition: border-color .2s;
    }

        .firma-preview:hover {
            border-color: #2563eb;
        }

        .firma-preview img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .firma-preview .firma-placeholder {
            font-size: .72rem;
            color: #94a3b8;
            text-align: center;
            padding: .5rem;
        }

    .firma-label-top {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #64748b;
    }

    @@media print {
        .orden-action-bar {
            display: none !important;
        }

        .orden-band {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }
    }
</style>

<!-- ══════════════════ PANEL DE BÚSQUEDA ══════════════════ -->
<div id="busquedaPanel" style="max-width:480px;margin:6rem auto 0;">
    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div style="background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 100%);color:#fff;padding:1.5rem;text-align:center;">
            <div style="font-size:2.4rem;margin-bottom:.5rem;">🔧</div>
            <h5 class="fw-bold mb-0">Orden de Servicio</h5>
            <p class="mb-0 mt-1" style="font-size:.82rem;opacity:.85;">Ingresa el número de orden para cargar</p>
        </div>
        <div class="card-body p-4">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="inputVentaId"
                       placeholder="ID de Servicio" autofocus
                       autocomplete="off"
                       onkeydown="if(event.key==='Enter') buscarOrden()">
                <label for="inputVentaId">ID de Servicio</label>
            </div>
            <div id="busquedaError" class="alert alert-danger d-none py-2" role="alert" style="font-size:.83rem;"></div>
            <button class="btn btn-primary w-100 rounded-pill" onclick="buscarOrden()" id="btnBuscar">
                <i class="bi bi-search me-2"></i>Cargar Orden
            </button>

            <hr class="my-3">

            <p class="mb-2" style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#64748b;">
                <i class="bi bi-cloud-fill me-1" style="color:#2563eb;"></i>Buscar PDF en SharePoint
            </p>
            <div class="input-group">
                <input type="text" class="form-control" id="inputUniqueId"
                       placeholder="UniqueId del archivo"
                       style="font-size:.83rem;"
                       onkeydown="if(event.key==='Enter') buscarPorUniqueId()">
                <button class="btn btn-outline-primary" id="btnBuscarUniqueId" onclick="buscarPorUniqueId()">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <div id="spBuscarResult" class="d-none mt-2"></div>
        </div>
    </div>
</div>

<!-- ══════════════════ ORDEN WRAPPER ══════════════════ -->
<div id="ordenWrapper" class="d-none">

    <!-- Action bar -->
    <div class="orden-action-bar">
        <div>
            <span class="badge bg-primary-subtle text-primary rounded-pill me-2" style="font-size:.72rem;">SERVICIO</span>
            <span class="fw-semibold">Orden de Servicio / Mantenimiento</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="volverBusqueda()">
                <i class="bi bi-arrow-left me-1"></i>Cambiar orden
            </button>
            <button class="btn btn-success btn-sm rounded-pill" onclick="guardarContrato()" id="btnGuardar">
                <i class="bi bi-floppy-fill me-1"></i>Guardar
            </button>
            <button class="btn btn-primary btn-sm rounded-pill" onclick="generarPDF()">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Generar PDF
            </button>
            <button class="btn btn-info btn-sm rounded-pill text-white" id="btnSubirSharePoint" onclick="abrirModalSharePoint()">
                <i class="bi bi-cloud-upload-fill me-1"></i>Subir a SharePoint
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">

        <!-- Band header -->
        <div class="orden-band">
            <div class="d-flex align-items-start gap-3 flex-wrap">
                <div style="flex:2;min-width:180px;">
                    <p class="mb-1" style="font-size:.8rem;font-weight:700;" id="hdr_denominacion"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;" id="hdr_domicilio"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;" id="hdr_rfc"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;" id="hdr_telefono"></p>
                    <p class="mb-1" style="font-size:.75rem;opacity:.85;" id="hdr_horario"></p>
                    <p class="mb-0" style="font-size:.75rem;opacity:.85;" id="hdr_correo"></p>
                </div>
                <div style="flex:1;min-width:200px;">
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control bg-transparent border-white border-opacity-50"
                               id="numOrden" name="numOrden" placeholder="Orden" style="color:#fff;" readonly>
                        <label for="numOrden" style="color:rgba(255,255,255,.7);">Orden de Reparación</label>
                    </div>
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control bg-transparent border-white border-opacity-50"
                               id="fechaOrden" name="fechaOrden" placeholder="Fecha" style="color:#fff;" readonly>
                        <label for="fechaOrden" style="color:rgba(255,255,255,.7);">Fecha</label>
                    </div>
                    <div style="border-left:1px solid rgba(255,255,255,.3);padding-left:.75rem;margin-top:.5rem;">
                        <p class="mb-1" style="font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.7;">Localidad</p>
                        <p class="mb-0" style="font-size:.75rem;" id="hdr_localidad"></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- ══════ DATOS DEL CLIENTE ══════ -->
            <div class="sec-label">Datos del Cliente (Consumidor)</div>
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="nombreCliente" name="nombreCliente" placeholder="Nombre">
                        <label for="nombreCliente">Nombre</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="rfcCliente" name="rfcCliente" placeholder="RFC">
                        <label for="rfcCliente">R.F.C.</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="email" class="form-control" id="emailCliente" name="emailCliente" placeholder="Correo">
                        <label for="emailCliente">Correo electrónico</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="calleCliente" name="calleCliente" placeholder="Calle">
                        <label for="calleCliente">Calle</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="coloniaCliente" name="coloniaCliente" placeholder="Colonia">
                        <label for="coloniaCliente">Colonia</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="municipioCliente" name="municipioCliente" placeholder="Municipio">
                        <label for="municipioCliente">Delegación / Municipio</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="estadoCliente" name="estadoCliente" placeholder="Estado">
                        <label for="estadoCliente">Estado</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="tel" class="form-control" id="telefonoCliente" name="telefonoCliente" placeholder="Teléfono">
                        <label for="telefonoCliente">Teléfono</label>
                    </div>
                </div>
            </div>

            <!-- ══════ CARACTERÍSTICAS DEL VEHÍCULO ══════ -->
            <div class="sec-label">Características del Vehículo</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="marca" name="marca" placeholder="Marca">
                                <label for="marca">Marca</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="submarca" name="submarca" placeholder="Submarca">
                                <label for="submarca">Submarca</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="tipoVersion" name="tipoVersion" placeholder="Tipo / Versión">
                                <label for="tipoVersion">Tipo o versión</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="color" name="color" placeholder="Color">
                                <label for="color">Color</label>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="anioModelo" name="anioModelo" placeholder="Año">
                                <label for="anioModelo">Año-Modelo</label>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="capacidad" name="capacidad" placeholder="Cap.">
                                <label for="capacidad">Capacidad</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="niv" name="niv" placeholder="NIV">
                                <label for="niv">Número Identificación Vehicular</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="kmRecorridos" name="kmRecorridos" placeholder="Km">
                                <label for="kmRecorridos">Número de kilómetros recorridos</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="placas" name="placas" placeholder="Placas">
                                <label for="placas">Número de Placas</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="asesor" name="asesor" placeholder="Asesor">
                                <label for="asesor">Asesor</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="piramide" name="piramide" placeholder="Pirámide">
                                <label for="piramide">Pirámide</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="fechaRecepcion" name="fechaRecepcion" placeholder="Recepción">
                                <label for="fechaRecepcion">Fecha y hora de Recepción</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="fechaEntrega" name="fechaEntrega" placeholder="Entrega">
                                <label for="fechaEntrega">Fecha y hora de Entrega</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-block mb-0">
                                <div class="info-block-title">Partes y/o refacciones reemplazadas</div>
                                <p style="font-size:.78rem;" class="mb-2">
                                    Se entregan las partes o refacciones reemplazadas al consumidor:
                                    <span class="ms-2">
                                        <input class="form-check-input me-1" type="checkbox" id="chkSi"> <label for="chkSi" style="font-size:.78rem;">SI</label>
                                        <input class="form-check-input ms-3 me-1" type="checkbox" id="chkNo"> <label for="chkNo" style="font-size:.78rem;">NO</label>
                                    </span>
                                </p>
                                <p style="font-size:.78rem;" class="mb-1">NOTA: Las partes y/o refacciones NO se entregarán al consumidor cuando:</p>
                                <div class="d-flex gap-2 flex-wrap" style="font-size:.78rem;">
                                    <div>a) Sean cambiadas en uso de garantía</div>
                                    <div>b) Se trate de residuos considerados peligrosos</div>
                                </div>
                                <p style="font-size:.78rem;" class="mt-2 mb-1">Servicio en el domicilio del consumidor:</p>
                                <div class="d-flex gap-3" style="font-size:.78rem;">
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkDomSi"> <label for="chkDomSi">SI</label></div>
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkDomNo"> <label for="chkDomNo">NO</label></div>
                                </div>
                                <p style="font-size:.78rem;" class="mt-2 mb-1">Póliza de seguro para cubrir al consumidor los daños o el extravío de bienes:</p>
                                <div class="d-flex gap-2 flex-wrap" style="font-size:.78rem;">
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkPolSi"> <label for="chkPolSi">SI</label></div>
                                    <span>Nº:</span>
                                    <input type="text" class="form-control form-control-sm d-inline-block" id="numPoliza" style="width:120px;">
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkPolNo"> <label for="chkPolNo">NO</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ══════ OPERACIONES / REFACCIONES ══════ -->
            <div class="sec-label">Operaciones a Efectuar y Partes y/o Refacciones</div>
            <div class="info-block">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" style="font-size:.8rem;">
                        <thead style="background:#1a3a6b;color:#fff;">
                            <tr>
                                <th style="width:12%;">Operaciones</th>
                                <th>Partes y/o Refacciones</th>
                                <th style="width:8%;">Cant.</th>
                                <th style="width:14%;">Precios Unitarios</th>
                                <th style="width:14%;">Total</th>
                            </tr>
                        </thead>
                        <tbody id="tablaOperaciones">
                            @for (int i = 0; i < 8; i++)
                            {
                                <tr>
                                    <td><input type="text" class="form-control form-control-sm border-0" placeholder=""></td>
                                    <td><input type="text" class="form-control form-control-sm border-0" placeholder=""></td>
                                    <td><input type="text" class="form-control form-control-sm border-0 text-center" placeholder=""></td>
                                    <td><input type="text" class="form-control form-control-sm border-0 text-end" placeholder="$0.00"></td>
                                    <td><input type="text" class="form-control form-control-sm border-0 text-end" placeholder="$0.00"></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold" style="font-size:.8rem;">Monto total de la operación:</td>
                                <td><input type="text" class="form-control form-control-sm border-0 text-end fw-bold" id="montoTotal" placeholder="$0.00"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- ══════ FORMA DE PAGO + SERVICIOS ADICIONALES ══════ -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-block h-100">
                        <div class="info-block-title">Forma de Pago</div>
                        <div class="row g-2">
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Monto de la operación:</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="montoOperacion" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Otros Cargos:</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="otrosCargos" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Servicios Adicionales:</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="serviciosAdicionales" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Parcial:</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="parcial" placeholder="$0.00">
                                    <label style="font-size:.7rem;">Importe</label>
                                </div>
                            </div>
                            <div class="col-8 d-flex align-items-center" style="font-size:.83rem;">Impuesto al Valor Agregado:</div>
                            <div class="col-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control form-control-sm" id="iva" placeholder="$0.00">
                                    <label style="font-size:.7rem;">IVA</label>
                                </div>
                            </div>
                            <div class="col-12 mt-1">
                                <div style="background:#eff6ff;border:2px solid #2563eb;border-radius:8px;padding:.5rem .9rem;font-size:.9rem;font-weight:700;color:#1a3a6b;"
                                     class="d-flex justify-content-between">
                                    <span>Monto Total (incluye mano de obra):</span>
                                    <span id="montoTotalPago"></span>
                                </div>
                            </div>
                            <div class="col-12 mt-1">
                                <div class="d-flex gap-3 align-items-center" style="font-size:.8rem;">
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkEfectivo"> <label for="chkEfectivo">Efectivo</label></div>
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkTarjeta"> <label for="chkTarjeta">Tarjeta de crédito</label></div>
                                    <div><input class="form-check-input me-1" type="checkbox" id="chkOtro"> <label for="chkOtro">Otro</label></div>
                                </div>
                            </div>
                        </div>
                    </div>
