    function llenarTablaOperaciones(operaciones) {
        const tbody = document.getElementById('tablaOperaciones');
        if (!tbody) return;

        tbody.innerHTML = '';
        let total = 0;

        if (operaciones.length > 0) {
            operaciones.forEach(op => {
                total += op.total ?? 0;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><input type="text" class="form-control form-control-sm border-0" value="${op.articulo ?? ''}" readonly></td>
                    <td><input type="text" class="form-control form-control-sm border-0" value="${op.descripcion ?? ''}" readonly></td>
                    <td><input type="text" class="form-control form-control-sm border-0 text-center" value="${op.cantidad ?? ''}" readonly></td>
                    <td><input type="text" class="form-control form-control-sm border-0 text-end" value="${op.precioUnitStr ?? ''}" readonly></td>
                    <td><input type="text" class="form-control form-control-sm border-0 text-end" value="${op.totalStr ?? ''}" readonly></td>`;
                tbody.appendChild(tr);
            });
        }

        const filasTotales = Math.max(operaciones.length, 8);
        for (let i = operaciones.length; i < filasTotales; i++) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><input type="text" class="form-control form-control-sm border-0" placeholder=""></td>
                <td><input type="text" class="form-control form-control-sm border-0" placeholder=""></td>
                <td><input type="text" class="form-control form-control-sm border-0 text-center" placeholder=""></td>
                <td><input type="text" class="form-control form-control-sm border-0 text-end" placeholder="$0.00"></td>
                <td><input type="text" class="form-control form-control-sm border-0 text-end" placeholder="$0.00"></td>`;
            tbody.appendChild(tr);
        }

        const montoEl = document.getElementById('montoTotal');
        if (montoEl && total > 0)
            montoEl.value = total.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
    }

