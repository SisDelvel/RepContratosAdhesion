    // SIGNATURE PAD
    // ══════════════════════════════════════════════════════
    let signaturePad = null;
    let firmaActual  = null;

    document.addEventListener('DOMContentLoaded', () => {
            initFirmaModal();

        const params = new URLSearchParams(window.location.search);
        const idServicio = params.get('idServicio');
        if (idServicio) {
            document.getElementById('inputVentaId').value = idServicio;
            buscarOrden();
        }
    });

    function initFirmaModal() {
        const canvas  = document.getElementById('firmaCanvas');
        const modalEl = document.getElementById('modalFirma');

        signaturePad = new SignaturePad(canvas, {
            backgroundColor: 'rgb(255,255,255)',
            penColor: 'rgb(15, 23, 42)'
        });

        modalEl.addEventListener('shown.bs.modal', () => {
            const ratio = Math.max(window.devicePixelRatio || 1, 1);
            canvas.width  = canvas.offsetWidth  * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext('2d').scale(ratio, ratio);
            signaturePad.clear();
        });

        document.getElementById('btnLimpiarFirma').addEventListener('click', () => signaturePad.clear());

        document.getElementById('btnConfirmarFirma').addEventListener('click', () => {
            if (signaturePad.isEmpty()) { alert('Por favor dibuja tu firma antes de confirmar.'); return; }
            const dataUrl = signaturePad.toDataURL('image/png');
            guardarFirmaEnPreview(firmaActual, dataUrl);
            bootstrap.Modal.getInstance(modalEl).hide();
        });
    }

    function abrirFirma(nombre) {
        firmaActual = nombre;
        document.getElementById('modalFirmaLabel').textContent = `Firma — ${nombre}`;
        new bootstrap.Modal(document.getElementById('modalFirma')).show();
    }

    function guardarFirmaEnPreview(nombre, dataUrl) {
        const padEl = document.getElementById(`pad_${nombre}`);
        const rehEl = document.getElementById(`rehacer_${nombre}`);
        if (!padEl) return;
        padEl.innerHTML = `<img src="${dataUrl}" alt="Firma" style="max-width:100%;max-height:100%;object-fit:contain;">`;
        padEl.onclick = null;
        padEl.style.cursor = 'default';
        padEl.style.borderStyle = 'solid';
        padEl.style.borderColor = '#22c55e';
        if (rehEl) rehEl.classList.remove('d-none');
    }

    function rehacerFirma(nombre) {
        const padEl = document.getElementById(`pad_${nombre}`);
        const rehEl = document.getElementById(`rehacer_${nombre}`);
        padEl.innerHTML = `<div class="firma-placeholder"><i class="bi bi-pen d-block mb-1" style="font-size:1.2rem;"></i>Toca para firmar</div>`;
        padEl.onclick = () => abrirFirma(nombre);
        padEl.style.cursor = 'pointer';
        padEl.style.borderStyle = 'dashed';
        padEl.style.borderColor = '#cbd5e1';
        if (rehEl) rehEl.classList.add('d-none');
    }

